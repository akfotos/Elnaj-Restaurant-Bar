# --- Database ---
# Postgres. On Vercel, use the pooled connection string (POSTGRES_PRISMA_URL).
DATABASE_URL="postgresql://user:pass@host:5432/elnaj?sslmode=require"

# --- Sessions ---
# Required. Generate a strong secret: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Google OAuth (optional — enables "Continue with Google") ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI: https://<your-domain>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Apple OAuth (optional — enables "Continue with Apple") ---
# Apple Developer → Identifiers → Services ID (e.g. com.elnaj.web)
# Return URL: https://<your-domain>/api/auth/oauth/apple/callback (HTTPS required)
APPLE_CLIENT_ID=""

# --- Payments (planned) ---
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# PAYSTACK_SECRET_KEY=""
